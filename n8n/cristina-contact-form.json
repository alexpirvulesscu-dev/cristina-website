    {
      "parameters": {
        "jsCode": "// Tidies what the website form sent and decides if it is a real enquiry.\n// The form sends JSON; n8n puts it under \"body\".\nconst raw = $input.first().json.body;\nlet b = {};\ntry { b = typeof raw === 'string' ? JSON.parse(raw) : (raw || {}); } catch (e) { b = {}; }\n\n// trim, cap the length, and stop line breaks sneaking into single-line fields\nconst clean = (s, n) => String(s == null ? '' : s).replace(/\\r/g, '').trim().slice(0, n);\nconst name = clean(b.name, 120).replace(/\\n/g, ' ');\nconst email = clean(b.email, 200).replace(/\\s/g, '');\nconst message = clean(b.message, 4000);\n\n// real enquiry = they ticked the consent box, the hidden \"website\" trap is empty,\n// every field is filled in, and the email looks like an email\nconst ok = b.consent === true && !b.website && !!name && !!message &&\n           /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\n\nreturn [{ json: { ok, name, email, message, page: clean(b.page, 300), sentAt: clean(b.sentAt, 40) } }];"
      },
      "id": "8f179e01-5488-4b3d-a251-d0137beb9a24",
      "name": "Check and tidy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f74b1268-bb81-4104-9522-dca126805864",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "09c7306e-4f7d-4f8a-b798-c2d17cb0b32e",
      "name": "Real enquiry?",
