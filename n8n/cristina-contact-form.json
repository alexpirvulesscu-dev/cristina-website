    {
      "parameters": {
        "jsCode": "// Tidies what the website form sent and decides if it is a real enquiry.\n// The form sends JSON; n8n puts it under \"body\".\nconst raw = $input.first().json.body;\nlet b = {};\ntry { b = typeof raw === 'string' ? JSON.parse(raw) : (raw || {}); } catch (e) { b = {}; }\n\n// trim, cap the length, and stop line breaks sneaking into single-line fields\nconst clean = (s, n) => String(s == null ? '' : s).replace(/\\r/g, '').trim().slice(0, n);\nconst name = clean(b.name, 120).replace(/\\n/g, ' ');\nconst email = clean(b.email, 200).replace(/\\s/g, '');\nconst message = clean(b.message, 4000);\n\n// real enquiry = they ticked the consent box, the hidden \"website\" trap is empty,\n// every field is filled in, and the email looks like an email\nconst ok = b.consent === true && !b.website && !!name && !!message &&\n           /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\n\n// ---- prepare the text for the designed email. Everything a patient typed is made safe first,\n// so nothing they write can change how the email looks or behave like code.\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst firstName = name.split(' ')[0] || name;\nlet sentLocal = clean(b.sentAt, 40);\ntry {\n  const d = new Date(sentLocal);\n  if (!isNaN(d)) sentLocal = d.toLocaleString('en-GB', { timeZone: 'Europe/Bucharest', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' (Bucharest time)';\n} catch (e) {}\n// the reply greeting follows the page the person wrote from (the form sends \"ro\" from the Romanian pages)\nconst isRo = clean(b.lang, 5).toLowerCase().startsWith('ro');\nconst replySubject = isRo ? 'Solicitarea dumneavoastră de consultație' : 'Your consultation request';\nconst replyGreeting = isRo\n  ? 'Bună ziua, ' + firstName + ',\\n\\nVă mulțumim că ați luat legătura cu noi.\\n\\n'\n  : 'Dear ' + firstName + ',\\n\\nThank you for getting in touch.\\n\\n';\nconst replyHref = 'mailto:' + email + '?subject=' + encodeURIComponent(replySubject) +\n  '&body=' + encodeURIComponent(replyGreeting);\n\nreturn [{ json: {\n  ok, name, email, message, page: clean(b.page, 300), sentAt: clean(b.sentAt, 40),\n  nameHtml: esc(name), firstNameHtml: esc(firstName), emailHtml: esc(email),\n  messageHtml: esc(message).replace(/\\n/g, '<br>'),\n  sentLocal: esc(sentLocal), replyHref: esc(replyHref)\n} }];"
      },
      "id": "8f179e01-5488-4b3d-a251-d0137beb9a24",
      "name": "Check and tidy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f74b1268-bb81-4104-9522-dca126805864",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "09c7306e-4f7d-4f8a-b798-c2d17cb0b32e",
      "name": "Real enquiry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "info@cpdentalaesthetics.com",
        "subject": "={{ 'New consultation request: ' + $json.name }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head>\n<body style=\"margin:0;padding:0;background:#F0F4F8;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:#F0F4F8;\">New consultation request from {{ $json.nameHtml }}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F0F4F8;padding:28px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#FFFFFF;border-radius:16px;overflow:hidden;\">\n\n<tr><td align=\"center\" bgcolor=\"#1E2720\" style=\"background:#1E2720;padding:32px 32px 28px 32px;\">\n<a href=\"https://cpdentalaesthetics.com\" style=\"text-decoration:none;\"><img src=\"https://cristina-website-liart.vercel.app/assets/img/logo-white.png\" width=\"260\" alt=\"Cristina Pirvulescu, Dental Aesthetics\" style=\"display:block;width:260px;max-width:100%;height:auto;border:0;margin:0 auto;\"></a>\n</td></tr>\n<tr><td style=\"height:5px;line-height:5px;font-size:0;background:#6B8E23;\">&nbsp;</td></tr>\n\n<tr><td style=\"padding:32px 32px 4px 32px;\">\n<span style=\"display:inline-block;background:#E9EFE9;color:#55721C;font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:11px;letter-spacing:2px;padding:7px 14px;border-radius:99px;\">NEW ENQUIRY FROM THE WEBSITE</span>\n<h1 style=\"font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:36px;line-height:1.15;color:#2C3036;margin:18px 0 6px 0;\">{{ $json.nameHtml }}</h1>\n<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#6E7378;\">Received {{ $json.sentLocal }}</div>\n</td></tr>\n\n<tr><td style=\"padding:22px 32px 0 32px;\">\n<div style=\"font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:11px;letter-spacing:2px;color:#6E7378;margin-bottom:6px;\">EMAIL</div>\n<a href=\"mailto:{{ $json.emailHtml }}\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:17px;color:#55721C;text-decoration:underline;\">{{ $json.emailHtml }}</a>\n</td></tr>\n\n<tr><td style=\"padding:24px 32px 0 32px;\">\n<div style=\"font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:11px;letter-spacing:2px;color:#6E7378;margin-bottom:8px;\">THEIR MESSAGE</div>\n<div style=\"background:#E9EFE9;border-left:4px solid #6B8E23;border-radius:10px;padding:18px 22px;font-family:Georgia,'Times New Roman',serif;font-size:19px;line-height:1.55;color:#2C3036;\">{{ $json.messageHtml }}</div>\n</td></tr>\n\n<tr><td style=\"padding:30px 32px 6px 32px;\" align=\"left\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td style=\"background:#6B8E23;border-radius:99px;\"><a href=\"{{ $json.replyHref }}\" style=\"display:inline-block;padding:16px 34px;font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:16px;color:#FFFFFF;text-decoration:none;\">Reply to {{ $json.firstNameHtml }}</a></td>\n</tr></table>\n<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#6E7378;margin-top:14px;\">This opens a reply addressed to {{ $json.emailHtml }}. Pressing Reply on this email works too.</div>\n</td></tr>\n\n<tr><td style=\"padding:26px 32px 30px 32px;\">\n<div style=\"border-top:1px solid #D9DFD9;padding-top:18px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#8A8F95;\">\nThey agreed that their details are used only to reply to this enquiry (they ticked the privacy notice box on the form).<br>\nSent from the contact form at cpdentalaesthetics.com\n</div>\n</td></tr>\n\n</table>\n</td></tr></table>\n</body></html>",
        "options": {
          "appendAttribution": false,
          "senderName": "Website enquiry",
          "replyTo": "={{ $json.email }}"
        }
      },
